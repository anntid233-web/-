# ===========================================
# Telegram Bot Configuration
# ===========================================
# Get from @BotFather
BOT_TOKEN=your_bot_token_here

# Admin user IDs (comma-separated)
ADMIN_IDS=123456789,987654321

# ===========================================
# Database
# ===========================================
# SQLite (default) - no changes needed
# For PostgreSQL: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///bot.db

# ===========================================
# YooKassa (ЮKassa) Payment Integration
# ===========================================
# Get from https://yookassa.ru
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
# Optional: webhook secret for signature verification
YOOKASSA_WEBHOOK_SECRET=your_webhook_secret
# Return URL after payment (your bot username)
YOOKASSA_RETURN_URL=https://t.me/your_bot_username

# ===========================================
# Proxy6.net API
# ===========================================
# Get API key from https://proxy6.net (Profile -> API)
PROXY6_API_KEY=your_proxy6_api_key
# API endpoint (usually no need to change)
PROXY6_API_URL=https://proxy6.net/api

# ===========================================
# Bot Settings
# ===========================================
# Minimum deposit amount in RUB
MIN_DEPOSIT=100

# Referral bonus in RUB
REFERRAL_BONUS=50

# Markup percentage on proxy price (0.2 = 20%)
PROXY_MARKUP_PERCENT=0.2

# ===========================================
# Webhook Settings (optional)
# ===========================================
# Set to enable webhook mode (requires public HTTPS)
# WEBHOOK_HOST=your-domain.com
# WEBHOOK_PORT=8080
# WEBHOOK_PATH=/webhook