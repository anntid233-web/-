# Bot Configuration
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321

# Database
DATABASE_PATH=data/bot.db

# Payment Provider (cryptobot, yoomoney)
PAYMENT_PROVIDER=cryptobot

# CryptoBot (get token from @CryptoBot)
CRYPTOBOT_TOKEN=your_cryptobot_token

# YooMoney (optional)
YOOMONEY_TOKEN=your_yoomoney_token
YOOMONEY_WALLET=your_yoomoney_wallet_number

# Proxy Provider API (optional - for auto-fetching proxies)
PROXY_API_URL=https://api.proxy-provider.com
PROXY_API_KEY=your_api_key

# Bot Settings
SUPPORT_USERNAME=@your_support
REFERRAL_BONUS_PERCENT=10
MIN_DEPOSIT=1.0

# Webhook (optional - for production)
WEBHOOK_URL=https://your-domain.com
WEBHOOK_PORT=8443